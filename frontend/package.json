{
  "name": "keryx-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp run typecheck && vp build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.node.json",
    "lint": "vp lint . && eslint src",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "check": "vp run typecheck && vp run lint && vp run format:check",
    "test": "vp test run",
    "test:browser": "playwright test --config ../tests/dashboard/playwright.config.mjs",
    "rust:bindings": "cargo test -p keryx-core export_bindings -- --ignored"
  },
  "dependencies": {
    "@lucide/svelte": "1.16.0",
    "@tanstack/svelte-query": "6.0.3",
    "bits-ui": "2.18.1",
    "clsx": "2.1.1",
    "svelte": "5.55.9",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "24.9.1",
    "eslint": "9.38.0",
    "eslint-plugin-svelte": "3.12.5",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte-check": "4.3.2",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.4.0"
}

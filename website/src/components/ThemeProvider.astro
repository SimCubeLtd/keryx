<!-- Apply the saved choice before paint, on both Astro and Starlight pages. -->
<script is:inline>
  (() => {
    const key = 'keryx-theme';
    const system = window.matchMedia('(prefers-color-scheme: dark)');
    const parse = (value) => value === 'light' || value === 'dark' ? value : 'auto';
    const next = { auto: 'light', light: 'dark', dark: 'auto' };
    const names = { auto: 'System', light: 'Light', dark: 'Dark' };
    let mode = 'auto';
    try { mode = parse(localStorage.getItem(key)); } catch { /* Storage may be blocked. */ }

    function apply() {
      document.documentElement.dataset.theme = mode === 'auto'
        ? (system.matches ? 'dark' : 'light') : mode;
      document.documentElement.dataset.themeMode = mode;
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        const label = 'Colour mode: ' + names[mode] + '. Switch to ' + names[next[mode]];
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      });
    }

    apply();
    document.addEventListener('DOMContentLoaded', apply, { once: true });
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) return;
      mode = next[mode];
      try { localStorage.setItem(key, mode); } catch { /* The choice still works for this page. */ }
      apply();
    });
    system.addEventListener('change', () => { if (mode === 'auto') apply(); });
    window.addEventListener('storage', (event) => {
      if (event.key === key || event.key === null) { mode = parse(event.newValue); apply(); }
    });
  })();
</script>
